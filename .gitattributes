# 统一行尾与二进制判定，避免不同平台检出后产生无意义差异

# 默认：仓库内以 LF 存储，检出时为 LF
* text=auto eol=lf

# Windows 专用脚本：检出为 CRLF，兼容 Windows PowerShell 5.1
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# 文档
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# 二进制
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
